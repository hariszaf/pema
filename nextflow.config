manifest {
    name            = 'pema'
    description     = 'PEMA: a Pipeline for Environmental DNA Metabarcoding Analysis'
    mainScript      = 'pema.nf'
    nextflowVersion = '>=25.04.0'
}

// Containers are enabled through profiles: docker (default), podman, singularity, apptainer.
// Usage: nextflow run pema.nf --params-file config_files/pema.yaml -profile singularity
docker {
    enabled = true
}

profiles {
    docker {
        docker.enabled = true
    }
    podman {
        docker.enabled  = false
        podman.enabled  = true
    }
    singularity {
        docker.enabled           = false
        singularity.enabled      = true
        singularity.autoMounts   = true
    }
    apptainer {
        docker.enabled         = false
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }
    // Execution reports in pipeline_info/ (e.g. -profile docker,reports).
    // Every container used must provide `ps` (procps) for this to work.
    reports {
        timeline.enabled   = true
        timeline.overwrite = true
        timeline.file      = "pipeline_info/timeline.html"
        report.enabled     = true
        report.overwrite   = true
        report.file        = "pipeline_info/report.html"
        trace.enabled      = true
        trace.overwrite    = true
        trace.file         = "pipeline_info/trace.txt"
    }
}

process {
    // Retry once on failures that look transient (e.g. killed for memory, network errors)
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1
}
