#!/usr/bin/env bds

# Function to get OTUs using the VSEARCH algorithm
string clusteringVsearch(string{} params, string{} globalVars) {

      
   #### Prepare files
   globalVars{'outputFilePath'}.chdir()
   globalVars{'vsearchPath'} = globalVars{'genePath'} + '/' + params{'gene'} +  '/' + 'vsearch'
   task sed 's/_/;size=/g' all_samples.fasta > $globalVars{'vsearchPath'}/all_samples.fasta
   
   wait

   ######################  Execute the VSEARCH algorithms    #############################################
         
   globalVars{'vsearchPath'}.chdir()
   
   # Dereplicate -- but basically remove cases with less than minuniquesize
   task vsearch \
      --threads $params{'threads'} \
      --derep_fulllength all_samples.fasta \
      --minuniquesize $params{'numOligotons'} \
      --sizein \
      --sizeout \
      --fasta_width 0 \
      --uc all.derep.uc \
      --output all.derep.fasta
   
   wait
   
   # Execute the first clustering step
   task vsearch \
      --threads $params{'threads'} \
      --cluster_size all.derep.fasta \
      --id $params{'vsearchId'} \
      --strand both \
      --sizein \
      --sizeout \
      --fasta_width 0 \
      --uc all.preclustered.uc \
      --centroids all.preclustered.fasta
   
   wait

   # Chimera removal
   task vsearch \
      --threads $params{'threads'} \
      --uchime_denovo all.preclustered.fasta \
      --sizein \
      --sizeout \
      --fasta_width 0 \
      --nonchimeras all.denovo.nonchimeras.fasta
   
   wait

   # Change an output file name
   sys mv all.denovo.nonchimeras.fasta all.ref.nonchimeras.fasta
   
   # Here is a Perl script for two tasks; getting non-chimeras for the dereplicated case
   task $globalVars{'scripts'}/map_vsearch.pl all.derep.fasta all.preclustered.uc \
      all.ref.nonchimeras.fasta > all.nonchimeras.derep.fasta
   
   wait

   # .. and for the total sequences cases
   task $globalVars{'scripts'}/map_vsearch.pl all_samples.fasta \
      all.derep.uc all.nonchimeras.derep.fasta > all.nonchimeras.fasta
   
   wait

   # Execute the second clustering step
   # $globalVars{'path'}/tools/VSEARCH/vsearch-2.9.1-linux-x86_64/bin/
   task vsearch \
      --threads $params{'threads'} \
      --cluster_size all.nonchimeras.fasta \
      --id $params{'vsearchId'} \
      --strand both \
      --sizein \
      --fasta_width 0 \
      --uc all.clustered.uc \
      --relabel Otu \
      --centroids all.otus.fasta \
      # --otutabout all.otutab.txt
   
   wait

   # Based on the all.otus.fasta and the contigency table, build the abundance table

   task {
      sys python $globalVars{'scripts'}/buildAbundanceTableVsearch.py all_samples.fasta all.otus.fasta ../../../amplicon_contingency_table.tsv
      sys mv all.otus.fasta all_sequences_grouped.fa
      sys mv all.otutab.txt allTab_$params{'taxonomyFolderName'}.tsv   
   }

   wait

   println("OTU clustering using the VSEARCH algorithm has been completed.")

   return 'ok'

}

# Function to get ASVs using the Swarm v2 algorithm
string clusteringSwarm(string{} params, string{} globalVars) {


   #### Prepare files
   globalVars{'outputFilePath'}.chdir()

   task {
      sys cp all_samples.fasta $params{'assignmentPath'}/all_samples.fasta
      sys rm all_samples.fasta
   }

   wait

   # globalVars{'swarmPath'}.chdir()
   params{'assignmentPath'}.chdir()
   int d_param = params{'d'}.parseInt()

   # Here is the clustering step with SWARM algorithm
   string check = params{'assignmentPath'} + "/all_sequences_grouped.fa"

   if (check.exists()){

      string emsg = "\n" + "An all_sequences_grouped.fa file is already built." + "\n" + "If you wish to run again, please remove or rename the file."
      println(emsg)

      return "ok"

   } else if ( d_param < 6 ) {

      # Get clusters, then find chemeras -- and remove chemeric swarms
      swarmMinValues(params, globalVars)
      wait

   } else {

      # Get chimeras first, then run Swarm to get clusters
      swarmMaxValues(params, globalVars)
      wait
   }

   wait
   println('ASVs inference using the Swarm algorithm has been completed')
   
   # Build the ASVs contingency table 
   sys mv ../../../amplicon_contingency_table.tsv .

   wait

   # Remove oligotons
   if ( params{'removeOligotons'} == 'Yes' ){

      string olig_msg = "\n" + "-> Removing oligotons .. " + "\n"
      println(olig_msg)

      # Removing oligotons from swarms .stats and .swarms files
      task {
         sys python $globalVars{'scripts'}/removeOligotonsSwarm.py \
               asvs.stats \
               asvs.swarms \
               $params{'numOligotons'}
         }

      wait

      # Build representative .fasta
      task {
         sys awk '{print $3}' updated_asvs.stats | cat - <(cut -d_ -f1 updated_asvs.swarms) | sort -u > keep_hashes.txt
         sys awk 'BEGIN { \
                  while ((getline k < "keep_hashes.txt") > 0) keep[k] = 1; \
            } \
            /^>/ { \
                  split($1, a, "_"); \
                  sub(/^>/, "", a[1]); \
                  keep_entry = (a[1] in keep) \
            } \
            keep_entry' asvs_representatives_hash.fa > filtered_seqs.fasta
   
      }
      wait

      # Renaming and cleaning up
      task {
         sys mv asvs.stats asvs_oligotong_incl.stats
         sys mv asvs.swarms asvs_oligotong_incl.swarms
         sys mv updated_asvs.stats asvs.stats
         sys mv updated_asvs.swarms asvs.swarms
   
         sys mv asvs_representatives_hash.fa asvs_representatives_hash_chimeras_oligotons.fa
         sys mv filtered_seqs.fasta asvs_representatives_hash.fa

         sys rm keep_hashes.txt
      }

      wait

      println('✅ Oligotons have been removed from both FASTA and contingency table')
   }

   wait

   string conting_msg = "\n" + "-> Building ASV contingency table.. "  + "\n"
   println(conting_msg)

   sys bash $globalVars{'scripts'}/createASVsContingencyTable.sh 

   wait

   # Check if this is a second analysis to remove files not needed and make links to others 
   task {
      
      sys if [ $(find '$params{'assignmentPath'}' -name 'all_sequences_grouped.fa') ] ; then  rm all_sequences_grouped.fa ; fi
      # Remove abundance from hashes that will be used for tax assignment
      sys sed 's/_[0-9]*//' asvs_representatives.fa > tmp 
      sys mv tmp asvs_representatives.fa
      sys ln -s asvs_representatives.fa all_sequences_grouped.fa
   }

   wait

   # According to the Clustering step to come, we need to implement some transformations
   if ( params{'classifierAlgo'} == 'CREST' && ( params{'gene'} != '12S' ) ) {

      println('Build CREST input once Swarm has been completed')
      println('Transformations on the Swarm output to align to the CREST input are about to be implemented.')

      # task {
      #    sys bash $globalVars{'scripts'}/buildAllTableFile.sh
      # }

      wait

      sys cp asvs_contingency_table.tsv allTab_$params{'taxonomyFolderName'}.tsv

      wait
   }

   return 'ok'

}


string swarmMinValues(string{} params, string{} globalVars) {

   int d_param = params{'d'}.parseInt()

   println("-- Runnning Swarm (min)..")

   if ( d_param == 1){

      # $globalVars{'path'}/tools/swarm/swarm/bin/
      task swarm \
         -d 1 \
         -f \
         -b $params{'boundary'} \
         -t $params{'threads'} \
         -s asvs.stats \
         -w asvs_representatives_hash.fa < all_samples.fasta > asvs.swarms

      wait

   } else {

      # Run Swarm for d != 1
      println("-- SwarmMinValues() with d != 1.")
      task swarm \
           -d $params{'d'} \
           -t $params{'threads'} \
           -s asvs.stats \
           -w asvs_representatives_hash.fa < all_samples.fasta > asvs.swarms

      wait
   }

   # Remove chimeras
   string m2 = "\n\n" + "-- Remove chimeras using VSEARCH.."
   println(m2)

   task{
      sys sed 's/_/;size=/g' asvs_representatives_hash.fa > tmp
      sys rm asvs_representatives_hash.fa
      sys mv tmp asvs_representatives_hash.fa
   }
   # We do not use `sed -i` to make sure it is running as supposed to, across platforms 

   wait

   string nonchimeras_file = "all.denovo.nonchimeras.fasta"

   if (! nonchimeras_file.exists()) {

      task vsearch \
            --threads $params{'threads'} \
            --uchime_denovo asvs_representatives_hash.fa \
            --sizein \
            --sizeout \
            --fasta_width 0 \
            --nonchimeras all.denovo.nonchimeras.fasta

      wait

   } else {
      string prev_chimeras = "\n" + "Chimeras already calculated!"
      println(prev_chimeras)
   }

   task {
      sys sed 's/;size=/_/g' all.denovo.nonchimeras.fasta > tmp 
      sys rm all.denovo.nonchimeras.fasta
      sys mv tmp all.denovo.nonchimeras.fasta
   }

   wait

   # Remove chimeric swarms
   string chimeral_msg = "\n" + "-> Removing chimeras after swarms were inferred.. " + "\n"
   println(chimeral_msg)
   task {

      sys grep '^>' all.denovo.nonchimeras.fasta | cut -d'_' -f1 | sed 's/^>//' | sort -u > fasta_hashes.txt
      sys grep -Ff fasta_hashes.txt asvs.stats > filtered_asvs.stats
      sys grep -Ff fasta_hashes.txt asvs.swarms > filtered_asvs.swarms

      sys awk '{print $3}' filtered_asvs.stats | cat - <(cut -d_ -f1 filtered_asvs.swarms) | sort -u > keep_hashes.txt
      sys awk 'BEGIN { \
               while ((getline k < "keep_hashes.txt") > 0) keep[k] = 1; \
         } \
         /^>/ { \
               split($1, a, "_"); \
               sub(/^>/, "", a[1]); \
               keep_entry = (a[1] in keep) \
         } \
         keep_entry' all.denovo.nonchimeras.fasta > filtered_seqs.fasta

      # Renaming files
      sys mv asvs.stats with_chimeras.stats
      sys mv asvs.swarms with_chimeras.swarms
      sys mv filtered_asvs.stats asvs.stats
      sys mv filtered_asvs.swarms asvs.swarms
      sys mv asvs_representatives_hash.fa asvs_representatives_hash_chimeras.fa
      sys mv filtered_seqs.fasta asvs_representatives_hash.fa

      # Cleaning up
      sys rm keep_hashes.txt
      sys rm fasta_hashes.txt

   }

   wait

   return 'ok'

}  

# In this case, chimera removal goes before the ASVs inference
string swarmMaxValues(string{} params, string{} globalVars){

   # Remove chimeras
   println("-- Remove chimeras using VSEARCH..")

   task{
      sys sed 's/_/;size=/g' all_samples.fasta > tmp
      sys rm all_samples.fasta
      sys mv tmp all_samples.fasta
   }

   wait

   task vsearch \
      --threads $params{'threads'} \
      --uchime_denovo all_samples.fasta \
      --sizein --sizeout --fasta_width 0 \
      --nonchimeras all.denovo.nonchimeras.fasta

   wait

   # Run Swarm for d > 6
   println("-- Runnning Swarm (max)..")

   task {
      sys sed 's/;size=/_/g' all.denovo.nonchimeras.fasta > tmp 
      sys rm all.denovo.nonchimeras.fasta
      sys mv tmp all.denovo.nonchimeras.fasta
   }

   wait

   task swarm \
         -d $params{'d'} \
         -t $params{'threads'} \
         -s asvs.stats \
         -w asvs_representatives_hash.fa < all.denovo.nonchimeras.fasta > asvs.swarms

   wait

   return 'ok'

}

