#!/usr/bin/env bds

# This is P.E.M.A!  A metabarcoding pipenline for environmental DNA samples.
# Author: Haris Zafeiropoulos
# date  : 2017-2018


help Hello friend. 
# If you need an empty line, make sure you levave a space (blank) after the `help` command.
help 
help This is PEMA, a pipeline to run your amplicon sequence analysis
help starting from a set of paired-end sequencing files, up to a taxonomically assigned OTU/ASV table.
help 
help For any trouble you get, feel free to contact us through our Matrix community https://matrix.to/#/#pema-helpdesk_community:gitter.im
help or leave an issue on our GitHub repo: https://github.com/hariszaf/pema 

help Required parameters
config := ""    help Path to your configuaration file. You may see for templates on the config_files folder or under the sanity_check for more specific cases

help Other parameters
bool v, version    help Returns pema version.

pema_version := 2.2.0       


if ( args.isEmpty() ) {
    printHelp()
    exit(1)
} 

if ( v  || version) {
   print(pema_version)
   print("\n")
   exit(1)
}

print(args)

if ( ! args.has("-config") ) {
   print("No configuration file was provided. Please provide one. \n ")
   printHelp()
   exit(1)
}

# Load BDS pema modules
include "modules/initialize"
include "modules/preprocess"
include "modules/clustering"
include "modules/taxAssignment"
include "modules/postAssignment"

println("✅ Modules loaded.")

string parameterFilePath     = config.dirName()
print("config parameters' file directory:\n $parameterFilePath \n")


string filenameOnly
if ( config.indexOf("/") >= 0 ) {
   # It contains "/", extract part after last "/"
   filenameOnly = config.substr(config.lastIndexOf("/") + 1)
} else {
   # No "/", the full string is the filename
   filenameOnly = config
}

string parameterFile  = parameterFilePath + "/" + filenameOnly

string msg1 = "\n\n" + "- Using parameter file path: " + parameterFile
println(msg1)

# Read parameters file for the first time! 
string{} paramsFirstAssignment =  readParameterFile(parameterFile)
paramsFirstAssignment{'paramsFilePath'} = parameterFilePath


###############################################################
#                 Initialize analysis                      #
###############################################################

string init_msg = "\n\n" + "******   INITIALIZE VARIABLES   ******"
println(init_msg)

string{} globalVars = initializeAnalysis(paramsFirstAssignment)
wait

# If there are Trimlogs in the rawData file, PEMA does not run as it should. Hence, we remove them if there are any!
# I re-run this command because of FastQC and the way it reacts in multiple runs over the same folders
globalVars{'dataPath'}.chdir() ; 
sys if [ $(find '$globalVars{'dataPath'}' -name 'TrimLog*') ] ; then  rm TrimLog* ; fi

buildDirectories(paramsFirstAssignment, globalVars)

# IMPORTANT! Module to train classifiers is enabled through this statement
if ( paramsFirstAssignment.hasKey('custom_ref_db') && paramsFirstAssignment{'custom_ref_db'} == 'Yes' ){
  string{} initGlobalVars = globalVars
  wait
  string{} globalVars = trainClassifier(paramsFirstAssignment, initGlobalVars)
}
wait
globalVars{'parameterFile'} = parameterFile


###############################################################
#              PRE-PROCESSING
###############################################################

string prep_msg = "\n\n" + "******   SEQUENCE PREPROCESSING STEP   ******"
println(prep_msg)

# With the original approach
if ( paramsFirstAssignment{'preprocess'} == 'original' ) {

   # * Quality Control
   qualityControl(paramsFirstAssignment, globalVars)
   wait

   # * Trimming
   parameterFilePath.chdir()
   string{} paramsTrimmoStep = readParameterFile(parameterFile)

   globalVars{'dataPath'}.chdir()

   # If ITS as marker gene, remove length variablity with cutadat
   if ( (paramsTrimmoStep{'gene'} == 'ITS') && (paramsTrimmoStep{'cutadapt'} == 'Yes') ) {
      globalVars = cutadaptForIts(paramsTrimmoStep, globalVars)
   }
   wait

   # Trim fastq files using Trimmomatic
   trimSeqs(paramsTrimmoStep, globalVars)
   wait

   # * Sequence adjustment
   parameterFilePath.chdir()
   string{} paramsBayesHammerStep = readParameterFile(parameterFile)
   
   adjustSeqs(paramsBayesHammerStep, globalVars)
   wait

   # Merging the paired-end samples
   parameterFilePath.chdir()
   string{} paramsSpadesMerging = readParameterFile(parameterFile)

   merging(paramsSpadesMerging, globalVars)
   wait

} else {

   # With fastp
   if ((paramsFirstAssignment{'gene'} == 'ITS') && ( paramsFirstAssignment{'cutadapt'} == 'Yes')) {
      cutadaptForIts(paramsFirstAssignment, globalVars)
   }
   preprocessWithFastp(paramsFirstAssignment, globalVars)
   wait
}

################################################################
#           Dereplicate sequence samples                       #
################################################################

string derepl_msg = "\n\n" + "******   DEREPLICATION STEP   ******"
println(derepl_msg)

parameterFilePath.chdir()
string{} paramsDereplication =  readParameterFile(parameterFile)

# Build subdirectories according to the params file
buildDirectories(paramsDereplication, globalVars)
wait

# Dereplicate
println('Pema is at the dereplication step; this may take a while.')

if ( paramsDereplication{'clusteringAlgo'} == 'swarm' ) {

   println("🔨Dereplication for the Swarm case to infer clusters.")
   swarmDereplicate(paramsDereplication, globalVars)
   wait

} else {

   string obiderep_msg = "\n" + "🔨Dereplication for the case of VSEARCH." + "\n"
   println(obiderep_msg)
   globalVars = obiDereplicate(paramsDereplication, globalVars)

   wait

   string merge_msg = "\n" + "🔨 Merging reads from all files in a single file." + "\n"
   println(merge_msg)
   mergeFilesNonSwarm(paramsDereplication, globalVars)

   wait

}

string clustering = globalVars{'outputPoint'} + "/clustering.chp"
checkpoint clustering

################################################################
#             OTUs clustering / ASVs inference                #
################################################################

string denoise_msg = "\n\n" + "******   OTU CLUSTERING / ASV INFERENCE  STEP   ******"
println(denoise_msg)

parameterFilePath.chdir()
string{} paramsOfTable =  readParameterFile(parameterFile)

if ( paramsDereplication{'clusteringAlgo'} == 'vsearch' ) {

   clusteringVsearch(paramsOfTable, globalVars)

} else if (paramsDereplication{'clusteringAlgo'} == 'swarm') {

   clusteringSwarm(paramsOfTable, globalVars)

}

println("The OTUs clustering / ASVs inference step has been completed.")
string taxAssign = globalVars{'outputPoint'} + "/taxAssign.chp"
checkpoint taxAssign

################################################################
#                   Taxonomic assignment                       #
################################################################

string tax_assign_msg = "\n\n" + "******   TAXONOMY ASSIGNMENT STEP   ******"
println(tax_assign_msg)

parameterFilePath.chdir()
string{} paramsForTaxAssign =  readParameterFile(parameterFile)
print("~~~")
print(paramsForTaxAssign)
print("~~~")

if ( paramsForTaxAssign.hasKey('custom_ref_db') && paramsForTaxAssign{'custom_ref_db'} == 'Yes') {

   string using_custom_db_msg = "\n" + "Taxonomy assignment using custom database.. " + "\n"
   println(using_custom_db_msg)

   if ( paramsForTaxAssign{'classifierAlgo'} == 'RDPClassifier' ) {

      rdpAssign(paramsForTaxAssign, globalVars)

   } else if ( paramsForTaxAssign{'classifierAlgo'} == 'CREST' ) {

      crestAssign(paramsForTaxAssign, globalVars)

   } else {

      println('The classifier you chose is not available in the Pema framework.')
   }

} else {

   string using_db_msg = "\n" + "Taxonomy assignment using a global database.. " + "\n"
   println(using_db_msg)

   string phylo_msg = "\n" + ">> Taxonomy assignmnet using a phylogeny-based approach.."
   string align_msg = "\n" + ">> Taxonomy assignment using an alignment-based approach"

   if ( paramsForTaxAssign{'gene'} == '16S') {

      if (paramsForTaxAssign{'classifierAlgo'} == 'RDPClassifier') {

         string msg_er = "\n\n" + "WARNING: Pema cannot use RDPClassifier for your marker gene." + "\n" +\
                     "It will use CREST instead and the relative parameter will change accordingly."
         println(msg_er)
         
         globalVars{'classifierAlgo'}         = 'CREST'
         paramsForTaxAssign{'classifierAlgo'} = 'CREST'
         wait

      }

      if (paramsForTaxAssign{'taxonomyAssignmentMethod'} != 'phylogeny') {

         println(align_msg)
         crestAssign(paramsForTaxAssign, globalVars)
         wait
         println("Alignment based taxonomy assignment using the CREST classifier has been completed.")

      } else {
   
         println(phylo_msg)
         phylogenyAssign(paramsForTaxAssign, globalVars)
         wait
         println("Phylogeny based taxonomy assignment has been completed.")

      }

   } else if ( paramsForTaxAssign{'gene'} == 'COI' ) {

      if ( paramsForTaxAssign{'classifierAlgo'} == 'CREST' ) {

         crestAssign(paramsForTaxAssign, globalVars)
         wait
         println(" CREST classifier has been completed for COI data.")

      }
      
      if (paramsForTaxAssign{'classifierAlgo'} == 'RDPClassifier') {

         rdpAssign(paramsForTaxAssign, globalVars)
         wait
         println("Alignment based taxonomy assignment using the RDPClassifier has been completed.")

      }

   } else if (paramsForTaxAssign{'gene'} == '18S') {

      if ( paramsForTaxAssign{'classifierAlgo'} == 'RDPClassifier' ) {

         println('Pema cannot use RDPClassifier for your marker gene. It will use CREST instead and the relative parameter will change accordingly.')

         globalVars{'classifierAlgo'}         = 'CREST'
         paramsForTaxAssign{'classifierAlgo'} = 'CREST'
         wait

      }
      
      if ( paramsForTaxAssign{'classifierAlgo'} == 'CREST' ) {
 
         crestAssign(paramsForTaxAssign, globalVars)
         wait
         println("Alignment based taxonomy assignment using the CREST classifier has been completed.")

      }

   } else if (paramsForTaxAssign{'gene'} == 'ITS') {

      if ( paramsForTaxAssign{'classifierAlgo'} == 'RDPClassifier' ) {

         println('Pema cannot use RDPClassifier for your marker gene. It will use CREST instead and the relative parameter will change accordingly.')

         globalVars{'classifierAlgo'}         = 'CREST'
         paramsForTaxAssign{'classifierAlgo'} = 'CREST'
         wait
      } 
      
      if ( paramsForTaxAssign{'classifierAlgo'} == 'CREST' ) {
 
         crestAssign(paramsForTaxAssign, globalVars)
         wait
         println("Alignment based taxonomy assignment using the CREST classifier has been completed.")

      }

   } else if ( paramsForTaxAssign{'gene'} == '12S' ) {

      if ( paramsForTaxAssign{'classifierAlgo'} == 'CREST' ) {

         println('Pema cannot run 12S data using the CREST classifier. It will use RDPClassifer instead and the relative parameter will change accordingly.')

         globalVars{'classifierAlgo'}         = 'RDPClassifier'
         paramsForTaxAssign{'classifierAlgo'} = 'RDPClassifier'

         wait

      }
      
      if (paramsForTaxAssign{'classifierAlgo'} == 'RDPClassifier') {

         rdpAssign(paramsForTaxAssign, globalVars)
         wait
         println("Alignment based taxonomy assignment using the RDPClassifier has been completed.")

      }
   }

} 
println("The taxonomy assignment step has been completed.")

# Check for running the ncbi-taxonomist tool
if ( paramsForTaxAssign{'getNCBITaxId'} == 'Yes'){

    string ncbiId_msg = "\n\n" + "==> Getting NCBI Taxonomy IDs for the taxonomies assigned." + "\n"
    println(ncbiId_msg)
    ncbiTaxonomyMapping(paramsForTaxAssign, globalVars)

    println("The assignments on the tax_assigned_table.tsv file have been linked to NCBI Taxonomy ids.")
}

wait
string communAnal = globalVars{'outputPoint'} + "/communAnal.chp"
checkpoint communAnal

################################################################
#                Pema has been concluded                      #
################################################################

###  Move all the checkpoints
parameterFilePath.chdir()
string{} paramasFormatting =  readParameterFile(parameterFile)

if ( paramasFormatting{'emptyCheckpoints'} == 'Yes' ) {
   string checkpointsDir = 'checkpoints_for_' + paramasFormatting{'outputFolderName'}
   globalVars{'outputFilePath'}.chdir()
   checkpointsDir.mkdir()
   globalVars{'outputPoint'}.chdir()   
   sys mv *.chp $globalVars{'outputFilePath'}/$checkpointsDir
}
wait

# Make a copy of 'parameters.tsv' file to the output folder.
sys cp $globalVars{'parameterFile'} $globalVars{'outputFilePath'}

# Say goodbye
string success_msg = "\n\n" + "🚀 Pema has been completed successfully. Time for some ecology!" +  "\n" + "Thanks for using PEMA."
println(success_msg)
