#!/usr/bin/env bds

# Function to run the CREST classifier 
string crestAssign(string{} params, string{} globalVars) {

   string searchFile
   string assignmentsFile

   params{'assignmentPath'}.chdir()

   if (params{'minScore'} == "") {
      if (params{'searchAlgo'} == "vsearch") {
         params{'minScore'} = 0.75
      } else {
         params{'minScore'} = 155
      }
   }

   if ( params{'taxonomyFolderName'}.isDir() ){
      int previousRandomNumber = randInt( 100 )
      println("!! Moving previous built assignment folder: " + params{'taxonomyFolderName'}  + " to old." + previousRandomNumber + "." + params{'taxonomyFolderName'})
      task {
         sys mv $params{'taxonomyFolderName'} old.$previousRandomNumber.$params{'taxonomyFolderName'}
         sys mkdir $params{'taxonomyFolderName'}
      }
      wait
      searchFile      = params{'assignmentPath'} + '/' + "old." + previousRandomNumber + "." + params{'taxonomyFolderName'} + '/' + "search.hits"
      assignmentsFile = params{'assignmentPath'} + '/' + "old." + previousRandomNumber + "." + params{'taxonomyFolderName'} + '/' + "assignments.txt"

      if (assignmentsFile.exists()){
         sys cp $assignmentsFile $params{'assignmentPath'}/$params{'taxonomyFolderName'}
      }
   } else {
      searchFile = params{'assignmentPath'} + '/' + params{'taxonomyFolderName'} + '/' + "search.hits"
   }

   wait

   println("-- Search file: " + searchFile)

   assignmentsFile = params{'assignmentPath'} + '/' + params{'taxonomyFolderName'} + '/' + "assignments.txt"

   if (assignmentsFile.exists()){

      println("We already have a CREST-based assignment file on this case.")
   
   } else if ( ! params.hasKey('custom_ref_db') || params{'custom_ref_db'} != 'Yes') {

         runCrest4(searchFile, params, globalVars)

   # CASE 3:
   # Using the CREST algorithm with a custom reference database
   } else {

      params{'referenceDb'} = globalVars{'name_of_custom_db'}
      runCrest4(searchFile, params, globalVars)
      wait
   }

   wait

   task {
      sys python $globalVars{'scripts'}/crestTaxTable.py \
            allTab_$params{'taxonomyFolderName'}.tsv \
            $params{'taxonomyFolderName'}/assignments.txt \
            $params{'clusteringAlgo'}
   }

   wait

   return 'ok'
}

# Crest4 
string runCrest4(string searchFile, string{} params, string{} globalVars) {

   string msg_in = "\n\n" + ">>>>>>>>> Taxonomy assignment using " + params{'referenceDb'} + " and crest4.." + "\n\n"
   println(msg_in)

   if (params{'referenceDb'} == "midori_1") {
      println("Only midori2 is available for Crest so PEMA will use this instead.")
      params{'referenceDb'} = "midori_2"
   }

   string{} gene_db_map 
   gene_db_map{'midori_2'}  = 'midori253darn'  # Our software DARN (https://github.com/hariszaf/darn) was applied for building this! :)
   gene_db_map{'silva_128'} = 'silvamod128'
   gene_db_map{'silva_138'} = 'silvamod138pr2'
   gene_db_map{'pr2'}       = 'silvamod138pr2'
   gene_db_map{'unite'}     = 'unite2025'
   if ( params.hasKey('custom_ref_db') && params{'custom_ref_db'} == "Yes") {
      gene_db_map{globalVars{'name_of_custom_db'}} = globalVars{'crest'} + "/" + globalVars{'name_of_custom_db'}
   }
   wait
   println(gene_db_map)

   string cmd
   if (searchFile.exists()) {
      println("Provide previously calculated search hits.")
      cmd = "crest4 --fasta all_sequences_grouped.fa " +\
            "--search_algo " + params{"searchAlgo"} + " " +\
            "--num_threads " + params{"threads"} + " " +\
            "--search_db "   + gene_db_map{params{'referenceDb'}} + " " +\
            "--search_hits " + searchFile + " " +\
            "--output_dir "  + params{"taxonomyFolderName"}

   } else {

      cmd = "crest4 --fasta all_sequences_grouped.fa " +\
            "--search_algo " + params{"searchAlgo"} + " " +\
            "--num_threads " + params{"threads"} + " " +\
            "--search_db "   + gene_db_map{params{'referenceDb'}} + " " +\
            "--output_dir "  + params{"taxonomyFolderName"}
   }

   string crest_command = "\n" + ">>> 🏷️" + cmd + "\n" + "<<<" + assignmentsFile
   println(crest_command)

   # Run Crest4
   task (taskName:="run-crest", canFail=true) {
      sys $cmd
   }
   # If I print something before the wait, it is shown before crest4 is done
   wait

   # Check output existence: For some reason, crest4 once complete, will maked bds exit by default 
   # We run this check to avoid this, after making sure assignments have been built.
   if (! assignmentsFile.exists()) {
      println("🔴 crest4 output not found. Aborting.")
      exit 1
   } else {
      println("🚀 crest4 output exists. Continuing despite potential failure.")
   }
   return "ok"
}


# Function to get the phylogeny based taxonomy assignmnent in case of the 16S marker gene
string phylogenyAssign(string{} params, string{} globalVars) {

   ## we need a REFERENCE TREE which we generated it from SILVA database with the aid of GAPPA.
   ## we used GAPPA in order to keep only 10.000 taxa from SILVA.
   ## we then used RAXML - NG which it returnerd us our REF TREE - you can find the corresponding script for
   ## getting this tree in  $path/tools/silva_132/for_placement
   ## in order to get our PHYLOGENY based taxonomy assignment we make use of EPA - NG // last version of Evolutionary Placement Algorithm
   
   params{'assignmentPath'}.chdir()
   
   wait
   
   string papara_alignment = globalVars{'assignmentPath'} + '/' + "papara_alignment.phy"

   if (papara_alignment.exists()) {

      string papara_exists_msg = "\n" + "PaPaRa alignment is already available."
      println(papara_exists_msg)

   } else {

      string papara_msg = "\n" + "-- Running PaPaRa.. " + "\n"
      println(papara_msg)

      # PaPaRa returns a msa of our queries that has taken into account info from our ref tree 
      task $globalVars{'tools'}/papara_static_x86_64 \
      -t $globalVars{'pema_home'}/pema/ext_data/easy_tree/raxml_easy_right_refmsa.raxml.bestTree \
      -s $globalVars{'pema_home'}/pema/ext_data/easy_tree/raxml_easy_right_refmsa.raxml.reduced.phy \
      -q all_sequences_grouped.fa -r #-j 4
    
      wait
      
      # Remove the ref - msa - THIS IS A BUG OF EPA-ng !!!!
      sys tail -n +1038 papara_alignment.default > papara_alignment.phy
      wait
   
      # Convert our query msa to fasta format with a script we made because epa-ng can handle only fasta
      task bash $globalVars{'scripts'}/convertPhylipToFasta.sh papara_alignment.phy
      
      wait

   }

   # Execute epa-ng algorithm (evolutinary placement) in order to get our phylogenetic-based taxonomy assignment, at last!
   # $globalVars{'path'}/tools/EPA-ng/epa/bin/
   task epa-ng \
      -s $globalVars{'pema_home'}/pema/ext_data/easy_tree/raxml_easy_right_refmsa.raxml.reduced.phy.fasta \
      -t $globalVars{'pema_home'}/pema/ext_data/easy_tree/raxml_easy_right_refmsa.raxml.bestTree \
      -q papara_alignment.fasta \
      --model GTR{0.959447/2.52497/1.45842/1.06213/3.55143/1}+FU{0.237221/0.230211/0.294337/0.238231}+G4m{0.559838} # -w <output_dir>
   
   wait

   string assignFolder="phylo_tax_assignment"
   assignFolder.mkdir()
   sys mv epa* $assignFolder

   wait 

   # Build taxonomy table
   task python $globalVars{'scripts'}/phyloTaxTable.py \
      allTab_$params{'taxonomyFolderName'}.tsv \
      $assignFolder/epa_result.jplace \
      $params{'clusteringAlgo'}

   println("Phylogenetic based taxonomy assignemnt has been completed.")

   return 'ok'

}

# Function to build the OTU or the ASV table once the RDP classifier has been used
string rdpBuildingTable(string{} params, string{} globalVars) {

   task {
      sys awk -F "\t" '{print substr($0, index($0,$6)) }' tax_assign_temp.txt > taxonomies_tmp.txt 
      sys sed 's/Kingdom//g ; s/Phylum//g ; s/Class//g ; s/Order/g/ ; s/Family//g ; s/Genus//g ; s/Species//g' taxonomies_tmp.txt > taxonomies.txt
      sys awk '{print $1}' tax_assign_temp.txt > ids.txt
      sys paste ids.txt taxonomies.txt > tax_assignments.tsv
      sys rm ids.txt taxonomies_tmp.txt taxonomies.txt tax_assign_temp.txt
   }

   println('RDPClassifier has ran as it should ')

   wait
   
   # Create a table with the taxonomy assignment column
   task {
      sys python $globalVars{'scripts'}/RDPClassifierTable.py $params{'clusteringAlgo'}
   }

   wait

   return 'ok'
}

# Use the RDP Classifier with a database among Midori 1 and 2 or a custom one. 
string rdpAssign(string{} params, string{} globalVars) {

   println('RDPClassifier is about to start assigning your grouped sequences.')

   params{'assignmentPath'}.chdir()


   string tax_assign_file = "tax_assignments.tsv"

   if ( tax_assign_file.exists()){
      string tax_exist_msg = "\n" + "✅ RPDClassifier has already returned taxonomies (`tax_assignment.tsv`). " + "\n"
      println(tax_exist_msg)
      return "ok"
   }

   if ( params{'custom_ref_db'} != 'Yes' ) {

      if ( params{'gene'} == "COI" ) {

         task {
            sys java -Xmx64g \
                 -jar $globalVars{'tools'}/rdp_classifier_2.14/dist/classifier.jar classify \
                 -t $globalVars{'tools'}/rdp_classifier_2.14/TRAIN/$params{'referenceDb'}/rRNAClassifier.properties \
                 -o tax_assign_temp.txt all_sequences_grouped.fa
         }
         
      } else if ( params{'gene'} == "12S" ) {

         task { 
            sys java -Xmx64g \
                 -jar $globalVars{'tools'}/rdp_classifier_2.14/dist/classifier.jar classify \
                 -t $globalVars{'tools'}/rdp_classifier_2.14//TRAIN/12S_v2.0.0/rRNAClassifier.properties \
                 -o tax_assign_temp.txt all_sequences_grouped.fa
         }


      } else {

         println('You have selected a combination of parameters that Pema does not support.')

      }

   #  A custom db is used
   } else {

      # That is the case where a custom DB has been asked for the taxonomy step 
      task java -Xmx64g -jar $globalVars{'path'}/tools/RDPTools/classifier.jar classify \
            -t $globalVars{'path'}/tools/RDPTools/TRAIN/$globalVars{'name_of_custom_db'}/rRNAClassifier.properties \
            -o tax_assign_temp.txt all_sequences_grouped.fa

   }

   wait

   # Build finalTable 
   rdpBuildingTable(params, globalVars)

   wait

   return 'ok'

}
