# Build Singularity container based on the PEMA Docker image

# Set base image
Bootstrap: docker
From: hariszaf/pema:v.2.1.5

# Set Singularity environment
%post
export WORKDIR="/pema"
echo "export WORKDIR=$WORKDIR" >> $SINGULARITY_ENVIRONMENT
mkdir -p $WORKDIR

#pip install ncbi-taxonomist
#echo "export PATH=${PATH}:$HOME/.local/bin" >> ~/.bashrc 

# Exports needed
#echo "export PATH=/usr/lib/jvm/java-8-openjdk-amd64/bin:/usr/lib/jvm/java-11-openjdk-amd64/bin:/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/tools/BDS/.bds:/bin/gzip:/root/miniconda3/bin/ncbi-taxonomist" >> $SINGULARITY_ENVIRONMENT 

echo "export PATH=/usr/lib/jvm/java-8-openjdk-amd64/bin:\
/usr/lib/jvm/java-11-openjdk-amd64/bin:\
/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:\
/usr/sbin:/usr/bin:/sbin:/bin:/home/tools/BDS/.bds:\
/bin/gzip:/root/miniconda3/bin/ncbi-taxonomist" >> $SINGULARITY_ENVIRONMENT


mv /home/modules /home/pema_latest.bds /home/tools /home/scripts /pema


# Set basecommnad; run PEMA analysis
%runscript
export WORKDIR="/pema"  # Redundant, but just to be explicit
cd $WORKDIR
/home/tools/BDS/.bds/bds pema_latest.bds
